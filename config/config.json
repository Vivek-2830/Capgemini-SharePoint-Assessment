{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "knowledge-repository-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/knowledgeRepository/KnowledgeRepositoryWebPart.js",
          "manifest": "./src/webparts/knowledgeRepository/KnowledgeRepositoryWebPart.manifest.json"
        }
      ]
    },
    "landing-page-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/landingPage/LandingPageWebPart.js",
          "manifest": "./src/webparts/landingPage/LandingPageWebPart.manifest.json"
        }
      ]
    },
    "dashboard-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/dashboard/DashboardWebPart.js",
          "manifest": "./src/webparts/dashboard/DashboardWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "KnowledgeRepositoryWebPartStrings": "lib/webparts/knowledgeRepository/loc/{locale}.js",
    "LandingPageWebPartStrings": "lib/webparts/landingPage/loc/{locale}.js",
    "DashboardWebPartStrings": "lib/webparts/dashboard/loc/{locale}.js"
  }
}
